# Database
DATABASE_URL=postgresql+asyncpg://bot:botpass@db:5432/rememberbot

# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Webhook (ngrok URL for dev, https://yourdomain.com for prod)
WEBHOOK_BASE_URL=https://your-ngrok-url.ngrok.io

# AI Providers (at least one required)
AISTUDIO_API_KEY=your_aistudio_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
AIHUBMIX_API_KEY=your_aihubmix_api_key_here
