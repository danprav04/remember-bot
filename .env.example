# Database
DATABASE_URL=postgresql+asyncpg://bot:botpass@db:5432/rememberbot

# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Webhook (ngrok URL for dev, https://yourdomain.com for prod)
WEBHOOK_BASE_URL=https://your-ngrok-url.ngrok.io

# AI Providers (at least one required)
AISTUDIO_API_KEY=your_aistudio_api_key_here
AISTUDIO_BG_API_KEY=your_background_aistudio_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
AIHUBMIX_API_KEY=your_aihubmix_api_key_here

# Redis (document processing queue)
REDIS_URL=redis://redis:6379/0

# WhatsApp (Cloud API via PyWa — all optional, gateway disabled if empty)
WHATSAPP_PHONE_ID=your_phone_number_id_here
WHATSAPP_TOKEN=your_whatsapp_access_token_here
WHATSAPP_VERIFY_TOKEN=your_chosen_verify_token_here
WHATSAPP_APP_ID=your_meta_app_id_here
WHATSAPP_APP_SECRET=your_meta_app_secret_here
